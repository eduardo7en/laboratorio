{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name"
		},
		"AzureSqlDatabase2": {
			"type": "string"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/DML_GitHub_Persist')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Get Token",
						"description": ",,,",
						"type": "WebActivity",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "GET",
							"url": "https://256jwt.azurewebsites.net/api/getgithubtoken256"
						}
					},
					{
						"name": "GetDMLFile",
						"type": "WebActivity",
						"dependsOn": [
							{
								"activity": "Get Token",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "GET",
							"headers": {
								"Authorization": {
									"value": "Bearer @{activity('Get Token').output.token}",
									"type": "Expression"
								},
								"Accept": "application/vnd.github.v3.raw"
							},
							"url": {
								"value": "@concat('https://api.github.com/repos/', split(pipeline().parameters.permalink,'/')[3], '/', split(pipeline().parameters.permalink,'/')[4], '/contents/', split(pipeline().parameters.permalink,'/')[7], '?ref=', pipeline().parameters.branch)",
								"type": "Expression"
							}
						}
					},
					{
						"name": "ExecutaDML",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "GetDMLFile",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "[parameters('AzureSqlDatabase2')]",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": {
										"value": "@activity('GetDMLFile').output.Response",
										"type": "Expression"
									}
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					}
				],
				"parameters": {
					"branch": {
						"type": "string",
						"defaultValue": "0.0.0.1"
					},
					"permalink": {
						"type": "string",
						"defaultValue": "https://github.com/eduardo7en/azuretest/blob/0.0.0.1/insert.sql"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-03-19T03:07:53Z"
			},
			"dependsOn": []
		}
	]
}