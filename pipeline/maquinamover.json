{
	"name": "maquinamover",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "AzureFileStorageReadSettings",
							"recursive": true,
							"deleteFilesAfterCompletion": false
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureFileStorageWriteSettings",
							"copyBehavior": "FlattenHierarchy"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "origemorigem",
						"type": "DatasetReference",
						"parameters": {
							"arquivo": {
								"value": "@pipeline().parameters.nomedoarquivo",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "saidasaida",
						"type": "DatasetReference",
						"parameters": {
							"arquivoOrigem": {
								"value": "@concat('TEMP.', pipeline().parameters.nomedoarquivo)",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Copy data2",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Copy data1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureFileStorageWriteSettings"
						}
					},
					"enableStaging": false
				},
				"outputs": [
					{
						"referenceName": "saidasaida",
						"type": "DatasetReference",
						"parameters": {
							"arquivoOrigem": {
								"value": "@activity('Copy data1').output",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"nomedoarquivo": {
				"type": "string",
				"defaultValue": "software-architecture-patterns.pdf"
			}
		},
		"variables": {
			"CopyLog": {
				"type": "String",
				"defaultValue": "@string(activity('CopyOriginal').output)"
			}
		},
		"annotations": []
	}
}