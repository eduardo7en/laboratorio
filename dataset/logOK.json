{
	"name": "logOK",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureBlobStorage1",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"logContent": {
				"type": "string",
				"defaultValue": "@string(activity('CopyOriginal').output)"
			}
		},
		"annotations": [],
		"type": "Binary",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": {
					"value": "@concat(pipeline().parameters.nomedoarquivo, '.OK')",
					"type": "Expression"
				}
			}
		}
	}
}